(barney)version 1

package "systemd" {
    metadata {
        version "261.4"
        release 1

        summary "System and service manager"
        description "systemd is a suite of basic building blocks for a Linux system."
    }

    properties {
        (bool)with_utillinux #true
    }

    variant "bootstrap" {
        with_utillinux #false
    }

    depends {
        build {
            (binary)make
            systemd variant="bootstrap" conflicts=(prop)with_utillinux
            util-linux if=(prop)with_utillinux
        }
    }

}
