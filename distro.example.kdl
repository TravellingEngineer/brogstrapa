/// Example distro configuration

/// Declare our project with `ID` equal to `brogstrapa`
project brogstrapa {
    name "Brógstrapa"
    summary "A properly engineered distro"

    // maps to os-release fields
    links {
        home "https://github.com/TravellingEngineer/brogstrapa"
        bugs "https://github.com/TravellingEngineer/brogstrapa/issues"
    }
}
