// Environment module.
//
// Stable binding of variables in the current phase.
module env {
  variables {
    // (var)env::target
    target (var)phase::target
    prefix (var)phase::prefix
  }

  // exported into the shell environment
  exports {
    // exported as ENV_PREFIX
    PREFIX (var)prefix
    TARGET (var)target
  }
}
